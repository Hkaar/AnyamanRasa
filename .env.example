DATABASE_URL=postgres://anyaman:anyaman@localhost:5433/anyaman_rasa
# Comma-separated; newest first. Generate with: openssl rand -hex 32
SESSION_SECRETS=change-me-in-production
PORT=44100

# Supabase Auth (Project Settings → API). The anon/publishable key is used by the server.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Only for `npm run auth:demo-users` (creates the demo accounts). Never needed by the app.
SUPABASE_SERVICE_ROLE_KEY=
# Public origin used in Supabase redirect URLs (set when behind a proxy).
PUBLIC_URL=http://localhost:44100

# Uploaded photos. `local` (default) keeps them in UPLOAD_DIR (Docker: the uploads volume).
# `s3` uses any S3-compatible bucket. For Supabase Storage (Storage → S3 Connection):
#   S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION=<project region, e.g. ap-southeast-1>
#   S3_BUCKET=media
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = an S3 access key pair
#   MEDIA_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/media  (public bucket only)
MEDIA_STORAGE=local
UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
