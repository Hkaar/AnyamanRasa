{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{app/**,remix.json,tsconfig.json,package.json,node_modules/**}",
      "excludeFiles": "{app/**/*.test.ts,app/**/*.test.tsx,node_modules/typescript/**,node_modules/@tailwindcss/**,node_modules/tailwindcss/**,node_modules/lucide/**,node_modules/@types/**,node_modules/.cache/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        }
      ]
    }
  ]
}
