{
  "$schema": "./node_modules/remix/schema/remix.json",
  "db": {
    "adapter": {
      "type": "postgres",
      "connectionString": {
        "env": "DATABASE_URL"
      }
    },
    "migrations": {
      "directory": "./db/migrations"
    },
    "seed": "./db/seed.sql"
  },
  "test": {
    "setup": "./test/setup.ts",
    "concurrency": 1
  }
}
